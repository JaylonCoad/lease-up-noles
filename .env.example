# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API Keys.
# .env.local is gitignored; never commit real keys.

# Both values are safe to expose to the browser (that is what NEXT_PUBLIC_ means).
# Row-Level Security in the database is what protects the data, not these keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Do NOT add the secret key (sb_secret_...) here or anywhere with a NEXT_PUBLIC_ prefix.
# It bypasses Row-Level Security. Only local scripts (like the seed script) should use it.
